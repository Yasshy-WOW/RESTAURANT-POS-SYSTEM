# local: Swagger/ReDoc/OpenAPIを公開する(設計仕様書5.5節)。本番ではlocal以外を設定する
ENV=local

# ローカル開発: SQLite。本番: Azure Database for MySQL Flexible Serverの接続文字列に置き換える
# 例(本番): mysql+pymysql://<user>:<password>@<host>:3306/<dbname>?ssl_mode=REQUIRED
DATABASE_URL=sqlite:///./pos_app.db

# JWT署名鍵(設計仕様書5.1節)。本番はAzure Key Vault/環境変数で必ず上書きすること
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_this_key_must_be_at_least_32_bytes_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS許可オリジン(設計仕様書5.3節)。カンマ区切りで複数指定可
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# 初期管理者(staff_id=0001)投入用パスワード(設計仕様書5.8節・決定事項No.38)
INITIAL_ADMIN_PASSWORD=change-me-please
